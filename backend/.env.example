# RAG//GOA — Backend Environment Configuration

# 1. Speech-to-Text (Sarvam)
SARVAM_API_KEY=your_sarvam_api_key_here

# 2. Generation (Gemini)
GENERATION_PROVIDER=gemini
GENERATION_MODEL=gemini-1.5-flash-8b
GENERATION_API_KEY=your_gemini_api_key_here

# 3. Vector Database (Qdrant)
# Use 'local' for development, 'cloud' for production
QDRANT_MODE=local
# If using 'cloud', provide the URL and API Key
# QDRANT_URL=https://your-cluster-url.qdrant.tech
# QDRANT_API_KEY=your_qdrant_api_key_here

# 4. Embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
